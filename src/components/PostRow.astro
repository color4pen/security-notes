---
import {
  dateLabel,
  isOngoing,
  isUpdated,
  lastModified,
  postHref,
  readingMinutes,
  regions,
  summary,
  type Post,
} from '../lib/posts';
interface Props {
  post: Post;
  /** 「すべて」タブでは国内/海外の別を表示する */
  showRegion?: boolean;
}
const { post, showRegion = false } = Astro.props;
const domestic = post.data.region === 'domestic';
const updated = isUpdated(post);
// 国内は続報を追うので最終更新日を、海外は公開日を見出しの日付にする。
const shownDate = domestic ? lastModified(post) : post.data.date;
---

<article
  class="post-row"
  data-post
  data-tags={JSON.stringify(post.data.tags)}
  data-search={`${post.data.title} ${post.data.tags.join(' ')} ${summary(post)}`.toLowerCase()}
>
  <div class="post-main">
    <div class="post-topline">
      <time datetime={shownDate.toISOString()}>
        {domestic && updated ? '更新 ' : ''}
        {dateLabel(shownDate)}
      </time>
      {showRegion && (
        <span class="region-label">{regions[post.data.region].label}</span>
      )}
      <span class="topic-label">{post.data.tags[0]}</span>
      {(updated || isOngoing(post)) && (
        <span class="marks">
          {updated && (
            <span class="mark mark-updated">
              {domestic ? '続報あり' : '更新'}
            </span>
          )}
          {isOngoing(post) && <span class="mark mark-ongoing">続報待ち</span>}
        </span>
      )}
      <span class="reading">約{readingMinutes(post)}分で読む</span>
    </div>
    <h2 class="post-title">
      <a href={postHref(post)}>{post.data.title}</a>
    </h2>
    <p class="post-summary">{summary(post)}</p>
    <div class="tags">
      {post.data.tags.slice(1, 4).map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
  </div>
</article>
