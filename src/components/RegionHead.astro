---
import { regionHref, regions, type Region } from '../lib/posts';
interface Props {
  region: Region;
  count: number;
  /** 一覧ページではh1、トップの面見出しではh2 */
  level?: 1 | 2;
  link?: boolean;
}
const { region, count, level = 2, link = false } = Astro.props;
const info = regions[region];
const Heading = level === 1 ? 'h1' : 'h2';
---

<header class="desk-head">
  <div class="desk-title">
    <Heading id={`desk-${region}`}>
      <span class="desk-page">{info.page}</span>
      <span class="desk-label">{info.label}</span>
    </Heading>
    <span class="desk-count">{count}本</span>
    {link && count > 0 && (
      <a class="desk-more" href={regionHref(region)}>
        {info.label}の記事一覧 →
      </a>
    )}
  </div>
  <p class="desk-lead">{info.lead}</p>
</header>
