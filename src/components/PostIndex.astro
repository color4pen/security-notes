---
import PostRow from './PostRow.astro';
import type { Tab } from './DeskTabs.astro';
import { href, regions, type Post } from '../lib/posts';
import { categories, taxonomyOf, tagsIndexHref } from '../lib/taxonomy';
interface Props {
  tab: Tab;
  posts: Post[];
}
const { tab, posts } = Astro.props;
// タグ絞り込みの候補。分類（攻撃手法・対象技術・インシデント種別）ごとに、このタブの記事に付いているものだけを出す。
const counts = new Map<string, number>();
for (const post of posts)
  for (const tag of taxonomyOf(post))
    counts.set(tag.name, (counts.get(tag.name) ?? 0) + 1);
const groups = categories
  .map((category) => ({
    ...category,
    tags: category.tags.filter((tag) => counts.has(tag.name)),
  }))
  .filter((category) => category.tags.length > 0);
const hasTopics = groups.length > 0;
// タブ名・本数はタブに出ているので、ここでは繰り返さない（見出しはスクリーンリーダー向け）。
const intro = {
  all: {
    title: 'すべての記事',
    lead: '公開日の新しい順に並べています。',
  },
  domestic: {
    title: `${regions.domestic.page}（${regions.domestic.label}）の記事`,
    lead: '続報を追記しながら記録しています。公開日の新しい順（続報を追記した記事は更新日も併記）。',
  },
  overseas: {
    title: `${regions.overseas.page}（${regions.overseas.label}）の記事`,
    lead: '根本原因と対策の観点で読み解きます。公開日の新しい順。',
  },
  vuln: {
    title: `${regions.vuln.page}（${regions.vuln.label}）の記事`,
    lead: '影響バージョンと今すぐやることに絞ってまとめます。公開日の新しい順。',
  },
}[tab];
const hasPosts = posts.length > 0;
---

<div class:list={['wrap blog-layout', { 'no-filter': !hasPosts }]}>
  {hasPosts && (
    <div
      class="filter-bar"
      id="filters"
      role="search"
      aria-label="記事を探す"
      hidden
    >
      <label class="search">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="6" />
          <path d="m15 15 5 5" />
        </svg>
        <span class="sr-only">このタブの記事を検索</span>
        <input id="search" type="search" placeholder="キーワードで探す" />
      </label>
      {tab !== 'all' && (
        <p class="other-hits" id="other-hits" hidden>
          他の面にも <span id="other-count">0</span>件 →{' '}
          <a id="other-link" href={href('')}>
            すべての記事で探す
          </a>
        </p>
      )}
    </div>
  )}

  <section class="articles" id="articles" aria-labelledby="tab-title">
    <h1 class="sr-only" id="tab-title">
      {intro.title}
    </h1>
    <p class="tab-lead">{intro.lead}</p>
    {hasPosts && hasTopics && (
      <a class="mobile-tag-link" href="#tag-filter">
        タグで探す ↓
      </a>
    )}
    <p class="sr-only" id="result-count" role="status" aria-live="polite"></p>
    {hasPosts ? (
      <div class="post-list">
        {posts.map((post) => (
          <PostRow post={post} showRegion={tab === 'all'} />
        ))}
      </div>
    ) : (
      <p class="tab-preparing">
        {tab === 'all' ? '記事は準備中です。' : regions[tab].empty}
      </p>
    )}
    <div class="empty" id="empty" hidden>
      <h2>一致するノートがありません</h2>
      <p>キーワードやタグを変えて探してみてください。</p>
      <button id="reset">絞り込みをリセット</button>
    </div>
  </section>
  <aside class="blog-sidebar" aria-label="ブログの案内">
    {hasPosts && hasTopics && (
      <section
        class="tag-panel"
        id="tag-filter"
        aria-labelledby="tag-heading"
        hidden
      >
        <h2 id="tag-heading">タグで探す</h2>
        <button class="filter-all" data-filter="all" aria-pressed="true">
          すべて
        </button>
        {groups.map((group) => (
          <div class="tag-group">
            <h3>{group.name}</h3>
            <div
              class="filter-buttons"
              role="group"
              aria-label={`${group.name}で絞り込み`}
            >
              {group.tags.map((tag) => (
                <button data-filter={tag.name} aria-pressed="false">
                  {tag.name}
                  <span class="count">{counts.get(tag.name)}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
        <a class="tags-index-link" href={tagsIndexHref}>
          すべての面のタグ一覧 →
        </a>
      </section>
    )}
    <section class="about" id="about" aria-labelledby="about-title">
      <h2 id="about-title">このブログについて</h2>
      <p>
        気になったセキュリティニュースを調べて、原因や対策をまとめています。出典で確認できた「事実」と、自分の「考察」を分けて書く、color4penの個人ブログです。
      </p>
    </section>
  </aside>
</div>
<script>
  // 検索・タグ絞り込みは表示中のタブの記事を絞り込み、他の面の該当件数も知らせる。
  // ?q=キーワード&tag=タグ で開くと、その条件で絞り込んだ状態から始まる。
  const filters = document.querySelector<HTMLElement>('#filters');
  const input = document.querySelector<HTMLInputElement>('#search');
  if (filters && input) {
    filters.hidden = false;
    const tagPanel = document.querySelector<HTMLElement>('#tag-filter');
    if (tagPanel) tagPanel.hidden = false;
    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
    ];
    const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const regionsHere = new Set(rows.map((row) => row.dataset.region));
    const otherHits = document.querySelector<HTMLElement>('#other-hits');
    const otherLink = document.querySelector<HTMLAnchorElement>('#other-link');
    const indexUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/search-index.json`;
    type Entry = { r: string; t: string[]; s: string };
    let index: Promise<Entry[]> | undefined;
    const params = new URLSearchParams(location.search);
    let selected = params.get('tag') ?? 'all';
    input.value = params.get('q') ?? '';
    const matches = (tags: string[], text: string, query: string) =>
      (selected === 'all' || tags.includes(selected)) && text.includes(query);
    const showOthers = async (query: string) => {
      if (!otherHits || !otherLink) return;
      if (!query && selected === 'all') {
        otherHits.hidden = true;
        return;
      }
      index ??= fetch(indexUrl).then((response) => response.json());
      const entries = await index;
      const count = entries.filter(
        (entry) => !regionsHere.has(entry.r) && matches(entry.t, entry.s, query),
      ).length;
      const search = new URLSearchParams();
      if (input.value.trim()) search.set('q', input.value.trim());
      if (selected !== 'all') search.set('tag', selected);
      otherLink.href = `${otherLink.pathname}?${search}`;
      document.querySelector('#other-count')!.textContent = String(count);
      otherHits.hidden = count === 0;
    };
    const update = () => {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      for (const row of rows) {
        const tags = JSON.parse(row.dataset.tags ?? '[]') as string[];
        const visible = matches(tags, row.dataset.search ?? '', query);
        row.hidden = !visible;
        if (visible) count++;
      }
      buttons.forEach((button) =>
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.filter === selected),
        ),
      );
      document.querySelector<HTMLElement>('#empty')!.hidden = count !== 0;
      document.querySelector('#result-count')!.textContent =
        `${count}件のノート`;
      const search = new URLSearchParams();
      if (input.value.trim()) search.set('q', input.value.trim());
      if (selected !== 'all') search.set('tag', selected);
      const qs = search.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      showOthers(query).catch(() => {});
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        selected = button.dataset.filter!;
        update();
        if (window.matchMedia('(max-width: 760px)').matches) {
          input.focus({ preventScroll: true });
          filters.scrollIntoView({ block: 'start', behavior: 'instant' });
        }
      }),
    );
    input.addEventListener('input', update);
    document.querySelector('#reset')!.addEventListener('click', () => {
      selected = 'all';
      input.value = '';
      update();
      input.focus();
    });
    if (input.value || selected !== 'all') update();
  }
</script>
