---
import Layout from '../../layouts/Layout.astro';
import PostIndex from '../../components/PostIndex.astro';
import { allPosts, postsIn, regions } from '../../lib/posts';
const posts = postsIn(await allPosts(), 'vuln');
const info = regions.vuln;
---

<Layout
  title={`${info.page}（${info.label}）`}
  description={info.lead}
  tab="vuln"
>
  <PostIndex tab="vuln" posts={posts} />
</Layout>
