---
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import RegionHead from '../../components/RegionHead.astro';
import {
  allPosts,
  href,
  postsIn,
  regionHref,
  regions,
  type Region,
} from '../../lib/posts';
export function getStaticPaths() {
  return (['domestic', 'overseas'] as const).map((region) => ({
    params: { region },
    props: { region },
  }));
}
const { region } = Astro.props as { region: Region };
const info = regions[region];
const posts = postsIn(await allPosts(), region);
const other: Region = region === 'domestic' ? 'overseas' : 'domestic';
---

<Layout
  title={`${info.page}（${info.label}）`}
  description={info.lead}
  section={region}
>
  <div class="wrap blog-layout region-layout">
    <section class="articles" aria-labelledby={`desk-${region}`}>
      <RegionHead region={region} count={posts.length} level={1} />
      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      ) : (
        <p class="desk-empty desk-preparing">{info.empty}</p>
      )}
      <p class="region-note">
        {region === 'domestic'
          ? '国内の記事は、続報が出るたびに追記し、最終更新日の新しい順に並べています。'
          : '海外の記事は公開日の新しい順に並べています。'}
      </p>
    </section>
    <aside class="blog-sidebar" aria-label="ほかの面へ">
      <section class="about region-switch">
        <h2>ほかの面を読む</h2>
        <p>
          <a href={regionHref(other)}>
            {regions[other].page}（{regions[other].label}） →
          </a>
        </p>
        <p>
          <a href={href('#articles')}>トップで検索・タグ絞り込み →</a>
        </p>
      </section>
    </aside>
  </div>
</Layout>
